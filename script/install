#!/usr/bin/env bash
#
# Run all dotfiles installers.

cd "$(dirname $0)"/..

if [ "$(uname -s)" = "Darwin" ]; then
  echo "› Setting temporary passwordless sudo"
  echo "$USER ALL=(ALL) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/dotfiles-temp > /dev/null
  trap 'sudo rm /etc/sudoers.d/dotfiles-temp 2>/dev/null' EXIT
fi

echo "› brew bundle"
brew bundle || echo "Some packages failed to install, continuing..."

find . -name install.sh | while read installer ; do
  echo "› ${installer}"
  sh -c "${installer}"
done

if [ "$(uname -s)" == "Darwin" ]; then
    ./homebrew/autoupdate.sh || true
    ./macos/set-defaults.sh
fi
