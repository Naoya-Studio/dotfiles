#!/usr/bin/env bash
#
# Run all dotfiles installers.

cd "$(dirname $0)"/..

# Keep sudo alive during long runs so Touch ID isn't asked repeatedly
SUDO_KEEPALIVE_PID=""
if [ "$(uname -s)" = "Darwin" ]; then
  sudo -v
  # Keep-alive: update existing `sudo` time stamp every 10s
  (while true; do sudo -n true; sleep 10; kill -0 "$$" || exit; done 2>/dev/null) &
  SUDO_KEEPALIVE_PID=$!
  trap 'kill $SUDO_KEEPALIVE_PID 2>/dev/null' EXIT
fi

echo "› brew bundle"
sudo -v
brew bundle || echo "Some packages failed to install, continuing..."
sudo -v

# Find the installers and run them iteratively
find . -name install.sh | while read installer ; do
  echo "› ${installer}"
  sudo -v
  sh -c "${installer}"
done

# Enable Homebrew autoupdate after bundle
if [ "$(uname -s)" == "Darwin" ]; then
    echo "› homebrew/autoupdate.sh"
    ./homebrew/autoupdate.sh || true
fi

# Run macOS settings (Touch ID setup needs pam-reattach from brew bundle)
if [ "$(uname -s)" == "Darwin" ]; then
    echo "› macos/set-defaults.sh"
    ./macos/set-defaults.sh
fi
