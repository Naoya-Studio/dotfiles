#!/bin/bash
#
# One entry point for setup. Pass one mode as first argument (with or without --).
#
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)"
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- full
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- core
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- homebrew
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- alfred
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- git
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- macos
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- github
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/setup)" -- ghostty
#

set -e

DOTFILES_REPO="https://github.com/Naoya-Studio/dotfiles.git"
DOTFILES_DIR="$HOME/dotfiles"

# Parse mode: full, core, homebrew, alfred, git, macos, github, ghostty (with or without --)
RAW="${1:-full}"
MODE="${RAW#--}"
case "$MODE" in
  full|core|homebrew|alfred|git|macos|github|ghostty) ;;
  *) echo "Usage: setup [--full|--core|--homebrew|--alfred|--git|--macos|--github|--ghostty]"; exit 2 ;;
esac

echo ""
echo "=== Dotfiles Setup ($MODE) ==="
echo ""

# --- macOS only checks ---
if [ "$(uname -s)" != "Darwin" ]; then
  if [ "$MODE" = "homebrew" ]; then
    echo "Homebrew on Linux: https://docs.brew.sh/Homebrew-on-Linux"
  else
    echo "This script is for macOS. Use full/core on a Mac."
  fi
  exit 1
fi

# --- Xcode Command Line Tools (needed for full, core, homebrew, and anything that uses brew) ---
need_xcode() {
  [ "$MODE" = "full" ] || [ "$MODE" = "core" ] || [ "$MODE" = "homebrew" ] || [ "$MODE" = "alfred" ] || [ "$MODE" = "github" ] || [ "$MODE" = "ghostty" ]
}
if need_xcode && ! xcode-select -p &>/dev/null; then
  echo "Installing Xcode Command Line Tools..."
  xcode-select --install
  echo "When the installer finishes, run this script again."
  exit 0
fi

# --- Sudo (for full, core, homebrew, macos) ---
need_sudo() {
  [ "$MODE" = "full" ] || [ "$MODE" = "core" ] || [ "$MODE" = "homebrew" ] || [ "$MODE" = "macos" ]
}
if need_sudo; then
  echo "Authenticating sudo (once)..."
  sudo -v
fi

# --- Xcode license (same as need_sudo for practical purposes) ---
if need_sudo && /usr/bin/xcrun clang 2>&1 | grep -q "license"; then
  echo "Accepting Xcode license..."
  sudo xcodebuild -license accept
fi

# --- Git only: no Homebrew, just git config ---
if [ "$MODE" = "git" ]; then
  echo "Setting Git user.name and user.email (global)."
  read -p "Git user.name: " GIT_NAME
  read -p "Git user.email: " GIT_EMAIL
  git config --global user.name "$GIT_NAME"
  git config --global user.email "$GIT_EMAIL"
  echo "Done."
  exit 0
fi

# --- Homebrew only: no clone, no gh ---
if [ "$MODE" = "homebrew" ]; then
  if command -v brew &>/dev/null; then
    echo "Homebrew is already installed: $(brew --prefix)"
    exit 0
  fi
  echo "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if [[ $(uname -m) == "arm64" ]]; then
    BREW_PREFIX="/opt/homebrew"
  else
    BREW_PREFIX="/usr/local"
  fi
  eval "$($BREW_PREFIX/bin/brew shellenv)"
  PROFILE="$HOME/.zprofile"
  SHELLENV_LINE="eval \"\$($BREW_PREFIX/bin/brew shellenv)\""
  if [ -f "$PROFILE" ] && grep -q "brew shellenv" "$PROFILE"; then
    echo "brew already in $PROFILE"
  else
    echo "" >> "$PROFILE"
    echo "# Homebrew" >> "$PROFILE"
    echo "$SHELLENV_LINE" >> "$PROFILE"
    echo "Added brew to $PROFILE"
  fi
  echo "Done. Open a new terminal or run: eval \"\$($BREW_PREFIX/bin/brew shellenv)\""
  exit 0
fi

# --- From here: need Homebrew for gh / brew install ---
need_brew() {
  [ "$MODE" = "full" ] || [ "$MODE" = "core" ] || [ "$MODE" = "alfred" ] || [ "$MODE" = "macos" ] || [ "$MODE" = "github" ] || [ "$MODE" = "ghostty" ]
}
if need_brew && ! command -v brew &>/dev/null; then
  echo "Homebrew is required for this mode. Run: bash -c \"\$(curl -fsSL .../script/setup)\" -- homebrew"
  exit 1
fi
if need_brew; then
  if [[ $(uname -m) == "arm64" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true
  else
    eval "$(/usr/local/bin/brew shellenv)" 2>/dev/null || true
  fi
fi

# --- GitHub CLI: gh auth only ---
if [ "$MODE" = "github" ]; then
  if ! command -v gh &>/dev/null; then
    brew install gh
  fi
  gh auth login
  echo "Done."
  exit 0
fi

# --- Ghostty: install cask only ---
if [ "$MODE" = "ghostty" ]; then
  brew install --cask ghostty
  echo "Done. Config: ~/.config/ghostty/config or in-app."
  exit 0
fi

# --- Clone dotfiles (for full, core, alfred, macos) ---
need_clone() {
  [ "$MODE" = "full" ] || [ "$MODE" = "core" ] || [ "$MODE" = "alfred" ] || [ "$MODE" = "macos" ]
}
if need_clone; then
  if ! command -v gh &>/dev/null; then
    brew install gh
  fi
  if ! gh auth status &>/dev/null; then
    echo "Please authenticate with GitHub:"
    gh auth login
  fi
  if [ -d "$DOTFILES_DIR" ]; then
    echo "Dotfiles already at $DOTFILES_DIR, pulling..."
    git -C "$DOTFILES_DIR" pull
  else
    echo "Cloning dotfiles..."
    git clone "$DOTFILES_REPO" "$DOTFILES_DIR"
  fi
fi

# --- Alfred only ---
if [ "$MODE" = "alfred" ]; then
  cd "$DOTFILES_DIR"
  ./alfred/install.sh
  echo "Done."
  exit 0
fi

# --- macOS defaults only ---
if [ "$MODE" = "macos" ]; then
  cd "$DOTFILES_DIR"
  ./macos/set-defaults.sh
  echo "Done."
  exit 0
fi

# --- Full: bootstrap ---
if [ "$MODE" = "full" ]; then
  if command -v mas &>/dev/null; then
    if ! mas account &>/dev/null; then
      echo "Sign in to App Store if needed, then press Enter..."
      open -a "App Store"
      read
    fi
  fi
  cd "$DOTFILES_DIR"
  ./script/bootstrap
  echo "Done."
  exit 0
fi

# --- Core: quickstart ---
if [ "$MODE" = "core" ]; then
  cd "$DOTFILES_DIR"
  ./script/quickstart
  echo "Done."
  exit 0
fi

exit 0
