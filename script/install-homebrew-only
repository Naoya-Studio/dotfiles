#!/bin/bash
#
# Install only Homebrew (Xcode CLT + license + brew). No dotfiles, no gh, no clone.
#
# One-liner (no clone):
#   bash -c "$(curl -fsSL https://raw.githubusercontent.com/Naoya-Studio/dotfiles/main/script/install-homebrew-only)"
#

set -e

if [ "$(uname -s)" != "Darwin" ]; then
    echo "This script is for macOS only. On Linux, see https://docs.brew.sh/Homebrew-on-Linux"
    exit 1
fi

echo ""
echo "=== Homebrew only (no dotfiles) ==="
echo ""

# Xcode Command Line Tools
if ! xcode-select -p &>/dev/null; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install
    echo "When the installer finishes, run this script again."
    exit 0
fi

# Sudo once for license + any brew install steps
echo "Authenticating sudo (once)..."
sudo -v

# Xcode license
if /usr/bin/xcrun clang 2>&1 | grep -q "license"; then
    echo "Accepting Xcode license..."
    sudo xcodebuild -license accept
fi

# Homebrew
if command -v brew &>/dev/null; then
    echo "Homebrew is already installed: $(brew --prefix)"
    exit 0
fi

echo "Installing Homebrew..."
/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

# PATH for this session
if [[ $(uname -m) == "arm64" ]]; then
    BREW_PREFIX="/opt/homebrew"
else
    BREW_PREFIX="/usr/local"
fi
eval "$($BREW_PREFIX/bin/brew shellenv)"

# Add brew to shell profile so new terminals get PATH (skip if already there)
PROFILE="$HOME/.zprofile"
SHELLENV_LINE="eval \"\$($BREW_PREFIX/bin/brew shellenv)\""
if [ -f "$PROFILE" ] && grep -q "brew shellenv" "$PROFILE"; then
    echo "brew already in $PROFILE"
else
    echo "" >> "$PROFILE"
    echo "# Homebrew" >> "$PROFILE"
    echo "$SHELLENV_LINE" >> "$PROFILE"
    echo "Added brew to $PROFILE"
fi

echo ""
echo "Done. Open a new terminal (or run: eval \"\$($BREW_PREFIX/bin/brew shellenv)\") so brew is in PATH."
echo ""
