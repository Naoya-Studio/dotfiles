#!/usr/bin/env bash
#
# Install core essentials first.

set -e
cd "$(dirname "$0")"/..

if [ "$(uname -s)" = "Darwin" ]; then
  echo "> Setting temporary passwordless sudo"
  echo "$USER ALL=(ALL) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/dotfiles-temp > /dev/null
  trap 'sudo rm /etc/sudoers.d/dotfiles-temp 2>/dev/null' EXIT
fi

./homebrew/install.sh

if ! command -v brew >/dev/null 2>&1; then
  [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
  [ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"
fi

echo "> brew bundle (core)"
brew bundle --file ./Brewfile.core

[ "$(uname -s)" == "Darwin" ] && ./github/install.sh || true
./git/install.sh || true
[ "$(uname -s)" == "Darwin" ] && ./macos/set-defaults.sh
[ "$(uname -s)" == "Darwin" ] && ./alfred/install.sh
[ "$(uname -s)" == "Darwin" ] && ./homebrew/autoupdate.sh || true

echo "\nCore setup done."
