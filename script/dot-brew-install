#!/usr/bin/env bash
# Install only allowlisted formulae/casks into /opt/homebrew-shared.
# Run via sudo from the brew wrapper. Allowlist is fetched from URL in /usr/local/etc/dot-brew-allowed-url.

set -e
ALLOWED_URL_FILE="/usr/local/etc/dot-brew-allowed-url"
SHARED_PREFIX="/opt/homebrew-shared"
SHARED_BREW="$SHARED_PREFIX/bin/brew.real"

# Allowlist from GitHub URL only (no local file)
if [ ! -f "$ALLOWED_URL_FILE" ]; then
  echo "dot-brew-install: allowlist URL not set. Run 'dot shared' as admin." >&2
  exit 1
fi
allowlist_content=$(/usr/local/bin/dot-brew-fetch-allowed 2>/dev/null)
if [ -z "$allowlist_content" ]; then
  echo "dot-brew-install: could not fetch allowlist from GitHub. Check network." >&2
  exit 1
fi
if [ ! -x "$SHARED_BREW" ]; then
  echo "dot-brew-install: shared Homebrew not found at $SHARED_PREFIX. Run 'dot shared' as admin." >&2
  exit 1
fi

# Parse allowlist: "brew <name>" and "cask <name>"; skip comments and empty lines.
allowed_formulae=()
allowed_casks=()
while IFS= read -r line; do
  line="${line%%#*}"
  line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [ -z "$line" ] && continue
  if [[ "$line" == "brew "* ]]; then
    allowed_formulae+=("${line#brew }")
  elif [[ "$line" == "cask "* ]]; then
    allowed_casks+=("${line#cask }")
  fi
done <<< "$allowlist_content"

subcmd="$1"
shift || true
RUN_USER="${SUDO_USER:-$USER}"
if [ "$subcmd" != "install" ] && [ "$subcmd" != "uninstall" ] && [ "$subcmd" != "upgrade" ]; then
  exec "$SHARED_BREW" "$subcmd" "$@"
fi

# Parse install/uninstall args: [--cask] [--force] [--zap] pkg1 [pkg2 ...]
pkgs=()
force_cask=false
install_extra=()
uninstall_extra=()
while [ $# -gt 0 ]; do
  case "$1" in
    --cask) force_cask=true ;;
    --force) [ "$subcmd" = "install" ] || [ "$subcmd" = "upgrade" ] && install_extra+=("$1") || uninstall_extra+=("$1") ;;
    --zap)   [ "$subcmd" = "uninstall" ] && uninstall_extra+=("$1") ;;
    *)       pkgs+=("$1") ;;
  esac
  shift
done

# Install: only allowlisted. Uninstall: allowlisted OR currently installed (so users can remove apps even if removed from allowlist).
formula_pkgs=()
cask_pkgs=()
for pkg in "${pkgs[@]}"; do
  in_formulae=false
  in_casks=false
  for a in "${allowed_formulae[@]}"; do [ "$pkg" = "$a" ] && in_formulae=true; done
  for a in "${allowed_casks[@]}"; do [ "$pkg" = "$a" ] && in_casks=true; done
  if [ "$force_cask" = true ]; then
    in_formulae=false
  fi
  if [ "$subcmd" = "uninstall" ] || [ "$subcmd" = "upgrade" ]; then
    # Uninstall: allow if on allowlist, or if installed in shared prefix (brew list / list --cask)
    if [ "$in_casks" = true ] || [ "$in_formulae" = true ]; then
      :
    else
      if sudo -u "$RUN_USER" env HOMEBREW_PREFIX="$SHARED_PREFIX" HOMEBREW_REPOSITORY="$SHARED_PREFIX" "$SHARED_BREW" list --cask 2>/dev/null | grep -Fxq "$pkg"; then
        in_casks=true
      elif sudo -u "$RUN_USER" env HOMEBREW_PREFIX="$SHARED_PREFIX" HOMEBREW_REPOSITORY="$SHARED_PREFIX" "$SHARED_BREW" list 2>/dev/null | grep -Fxq "$pkg"; then
        in_formulae=true
      else
        echo "dot-brew-install: '$pkg' is not installed (or not in allowlist)." >&2
        exit 1
      fi
    fi
  else
    if [ "$in_casks" = false ] && [ "$in_formulae" = false ]; then
      echo "dot-brew-install: '$pkg' is not in the allowlist. Only admin can add entries." >&2
      exit 1
    fi
  fi
  if [ "$in_casks" = true ]; then
    cask_pkgs+=("$pkg")
  elif [ "$in_formulae" = true ]; then
    formula_pkgs+=("$pkg")
  fi
done

# Homebrew must not run as root; run as the user who invoked sudo
run_brew() {
  # For upgrade, we might need sudo rights if updating casks in /Applications
  sudo -u "$RUN_USER" env HOMEBREW_PREFIX="$SHARED_PREFIX" HOMEBREW_REPOSITORY="$SHARED_PREFIX" "$SHARED_BREW" "$@"
}
failed=0
if [ "$subcmd" = "install" ]; then
  [ ${#formula_pkgs[@]} -gt 0 ] && run_brew install "${install_extra[@]}" "${formula_pkgs[@]}" || failed=1
  [ ${#cask_pkgs[@]} -gt 0 ] && run_brew install --cask "${install_extra[@]}" "${cask_pkgs[@]}" || failed=1
elif [ "$subcmd" = "upgrade" ]; then
  # Upgrade: if no packages specified, upgrade everything (brew upgrade).
  if [ ${#formula_pkgs[@]} -eq 0 ] && [ ${#cask_pkgs[@]} -eq 0 ] && [ ${#pkgs[@]} -eq 0 ]; then
     run_brew upgrade "${install_extra[@]}" || failed=1
  else
     [ ${#formula_pkgs[@]} -gt 0 ] && run_brew upgrade "${install_extra[@]}" "${formula_pkgs[@]}" || failed=1
     [ ${#cask_pkgs[@]} -gt 0 ] && run_brew upgrade --cask "${install_extra[@]}" "${cask_pkgs[@]}" || failed=1
  fi
else
  [ ${#formula_pkgs[@]} -gt 0 ] && run_brew uninstall "${uninstall_extra[@]}" "${formula_pkgs[@]}" || failed=1
  [ ${#cask_pkgs[@]} -gt 0 ] && run_brew uninstall --cask "${uninstall_extra[@]}" "${cask_pkgs[@]}" || failed=1
fi
exit $failed
exit $failed
