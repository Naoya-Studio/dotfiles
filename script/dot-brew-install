#!/usr/bin/env bash
# Install only allowlisted formulae/casks into /opt/homebrew-shared.
# Run via sudo from the brew wrapper. Allowlist is fetched from URL in /usr/local/etc/dot-brew-allowed-url.

set -e
ALLOWED_URL_FILE="/usr/local/etc/dot-brew-allowed-url"
SHARED_PREFIX="/opt/homebrew-shared"
SHARED_BREW="$SHARED_PREFIX/bin/brew.real"

# Allowlist from GitHub URL only (no local file)
if [ ! -f "$ALLOWED_URL_FILE" ]; then
  echo "dot-brew-install: allowlist URL not set. Run 'dot shared' as admin." >&2
  exit 1
fi
url=$(cat "$ALLOWED_URL_FILE")
allowlist_content=$(curl -sL --connect-timeout 5 "$url" 2>/dev/null)
if [ -z "$allowlist_content" ]; then
  echo "dot-brew-install: could not fetch allowlist from GitHub. Check network." >&2
  exit 1
fi
if [ ! -x "$SHARED_BREW" ]; then
  echo "dot-brew-install: shared Homebrew not found at $SHARED_PREFIX. Run 'dot shared' as admin." >&2
  exit 1
fi

# Parse allowlist: "brew <name>" and "cask <name>"; skip comments and empty lines.
allowed_formulae=()
allowed_casks=()
while IFS= read -r line; do
  line="${line%%#*}"
  line="$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  [ -z "$line" ] && continue
  if [[ "$line" == "brew "* ]]; then
    allowed_formulae+=("${line#brew }")
  elif [[ "$line" == "cask "* ]]; then
    allowed_casks+=("${line#cask }")
  fi
done <<< "$allowlist_content"

subcmd="$1"
shift || true
if [ "$subcmd" != "install" ] && [ "$subcmd" != "uninstall" ]; then
  exec "$SHARED_BREW" "$subcmd" "$@"
fi

# Parse install/uninstall args: [--cask] pkg1 [pkg2 ...]
pkgs=()
force_cask=false
while [ $# -gt 0 ]; do
  case "$1" in
    --cask) force_cask=true ;;
    *)      pkgs+=("$1") ;;
  esac
  shift
done

# Each pkg: allow if in formulae or casks; decide formula vs cask from allowlist (so "brew install google-chrome@beta" works without --cask)
formula_pkgs=()
cask_pkgs=()
for pkg in "${pkgs[@]}"; do
  in_formulae=false
  in_casks=false
  for a in "${allowed_formulae[@]}"; do [ "$pkg" = "$a" ] && in_formulae=true; done
  for a in "${allowed_casks[@]}"; do [ "$pkg" = "$a" ] && in_casks=true; done
  if [ "$force_cask" = true ]; then
    in_formulae=false
  fi
  if [ "$in_casks" = true ]; then
    cask_pkgs+=("$pkg")
  elif [ "$in_formulae" = true ]; then
    formula_pkgs+=("$pkg")
  else
    echo "dot-brew-install: '$pkg' is not in the allowlist. Only admin can add entries." >&2
    exit 1
  fi
done

# Homebrew must not run as root; run as the user who invoked sudo
RUN_USER="${SUDO_USER:-$USER}"
run_brew() {
  sudo -u "$RUN_USER" env HOMEBREW_PREFIX="$SHARED_PREFIX" HOMEBREW_REPOSITORY="$SHARED_PREFIX" "$SHARED_BREW" "$@"
}
failed=0
if [ "$subcmd" = "install" ]; then
  [ ${#formula_pkgs[@]} -gt 0 ] && run_brew install "${formula_pkgs[@]}" || failed=1
  [ ${#cask_pkgs[@]} -gt 0 ] && run_brew install --cask "${cask_pkgs[@]}" || failed=1
else
  [ ${#formula_pkgs[@]} -gt 0 ] && run_brew uninstall "${formula_pkgs[@]}" || failed=1
  [ ${#cask_pkgs[@]} -gt 0 ] && run_brew uninstall --cask "${cask_pkgs[@]}" || failed=1
fi
exit $failed
