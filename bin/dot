#!/bin/sh
#
# dot - management script
#   dot              — update everything (pull, brew, install)
#   dot --update     — sync current state to GitHub (Brewfile + all changes, commit & push)
#   dot pull         — force pull (discard local changes, match remote)
#   dot shared       — allow other users to brew install allowlisted packages (needs sudo)

set -e
DOTFILES=$HOME/dotfiles

# --- dot shared: allowlist brew for other users (read-only allowlist, shared prefix) ---
# Typo: shered → shared
if [ "$1" = "shered" ] || [ "$1" = "--shered" ]; then
  echo "Unknown command '$1'. Did you mean: dot shared ?" >&2
  exit 1
fi
if [ "$1" = "--shared" ] || [ "$1" = "shared" ]; then
  [ "$(uname -s)" != "Darwin" ] && echo "dot shared is for macOS only." && exit 1
  ALLOWED="$DOTFILES/homebrew/allowed.txt"
  [ ! -f "$ALLOWED" ] && echo "Missing $ALLOWED" && exit 1
  # add / remove / list: only owner of allowlist can add/remove; list is read-only
  case "${2:-}" in
    add|remove)
      owner=$(stat -f '%Su' "$ALLOWED" 2>/dev/null || true)
      if [ -z "$owner" ] || [ "$owner" != "$USER" ]; then
        echo "Only the owner of $ALLOWED can run: dot shared add/remove" >&2
        exit 1
      fi
      DOTFILES="$DOTFILES" bash "$DOTFILES/script/shared-allowlist.sh" "$2" "$3" "$4" "$5"
      exit 0
      ;;
    list)
      DOTFILES="$DOTFILES" bash "$DOTFILES/script/shared-allowlist.sh" "$2" "$3" "$4" "$5"
      exit 0
      ;;
  esac
  echo "› Setting up shared Homebrew..."
  bash "$DOTFILES/script/setup-shared-homebrew.sh"
  echo "› Allowing group write so other users can brew install..."
  sudo chgrp -R staff /opt/homebrew-shared
  sudo chmod -R g+w /opt/homebrew-shared
  sudo chmod -R g+s /opt/homebrew-shared
  echo "› Installing allowlist URL (brew-allowed / brew install fetch from GitHub)..."
  sudo mkdir -p /usr/local/etc
  sudo rm -f /usr/local/etc/dot-brew-allowed
  ALLOWED_URL=$(DOTFILES="$DOTFILES" bash "$DOTFILES/script/get-allowed-url.sh" 2>/dev/null) || true
  if [ -n "$ALLOWED_URL" ]; then
    echo "$ALLOWED_URL" | sudo tee /usr/local/etc/dot-brew-allowed-url > /dev/null
    echo "› Allowlist URL saved (brew-allowed / brew install will fetch from GitHub on this Mac and others)."
  fi
  echo "› Configuring git safe.directory for shared Homebrew (system-wide)..."
  if ! git config --system --get-all safe.directory | grep -q "^/opt/homebrew-shared$"; then
    sudo git config --system --add safe.directory /opt/homebrew-shared
  fi
  echo "› Installing dot-brew-install, dot-brew-fetch-allowed, brew wrapper, brew-allowed..."
  sudo cp "$DOTFILES/script/dot-brew-install" /usr/local/bin/dot-brew-install
  sudo cp "$DOTFILES/script/dot-brew-fetch-allowed" /usr/local/bin/dot-brew-fetch-allowed
  sudo chmod 755 /usr/local/bin/dot-brew-install /usr/local/bin/dot-brew-fetch-allowed
  # Standalone command: fetch via API (no CDN), show allowlist
  sudo sh -c 'cat > /usr/local/bin/brew-allowed << "END"
#!/bin/sh
content=$(/usr/local/bin/dot-brew-fetch-allowed 2>/dev/null)
if [ -z "$content" ]; then
  echo "Could not fetch allowlist. Check network or run: dot shared" >&2
  exit 1
fi
echo "Allowed (brew install for other users):"
echo "$content" | grep -v "^#" | grep -v "^[[:space:]]*$" | sed "s/^/  /"
END
  chmod 755 /usr/local/bin/brew-allowed'
  # Wrap /opt/homebrew-shared/bin/brew so "brew allowed" and allowlisted "brew install" work (PATH has this dir)
  SHARED_PREFIX="/opt/homebrew-shared"
  if [ ! -x "$SHARED_PREFIX/bin/brew.real" ]; then
    sudo mv "$SHARED_PREFIX/bin/brew" "$SHARED_PREFIX/bin/brew.real"
  fi
  sudo sh -c 'cat > /opt/homebrew-shared/bin/brew << "BREWWRAP"
#!/bin/sh
umask 002
case "$1" in
  allowed|allowlist)
    content=$(/usr/local/bin/dot-brew-fetch-allowed 2>/dev/null)
    if [ -z "$content" ]; then
      echo "Could not fetch allowlist. Check network or run: dot shared" >&2
      exit 1
    fi
    echo "Allowed (brew install for other users):"
    echo "$content" | grep -v "^#" | grep -v "^[[:space:]]*$" | sed "s/^/  /"
    ;;
  install|uninstall|upgrade) exec sudo /usr/local/bin/dot-brew-install "$@" ;;
  *) exec /opt/homebrew-shared/bin/brew.real "$@" ;;
esac
BREWWRAP
chmod 755 /opt/homebrew-shared/bin/brew'
  echo "› Adding /opt/homebrew-shared/bin to PATH for all users..."
  echo '/opt/homebrew-shared/bin' | sudo tee /etc/paths.d/dot-brew-shared > /dev/null
  if [ ! -f /etc/sudoers.d/dot-brew-install ]; then
    echo "› Allowing passwordless dot-brew-install for allowlisted installs..."
    echo 'ALL ALL=(ALL) NOPASSWD: /usr/local/bin/dot-brew-install *' | sudo tee /etc/sudoers.d/dot-brew-install > /dev/null
    sudo chmod 440 /etc/sudoers.d/dot-brew-install
  fi
  echo "› Allowing passwordless Cask install/uninstall to /Applications (copy, chown, rm for non-admin users)..."
  {
    echo 'ALL ALL=(ALL) NOPASSWD,SETENV: /bin/cp -pR /opt/homebrew-shared/Caskroom/*/*/* /Applications/*'
    echo 'ALL ALL=(ALL) NOPASSWD,SETENV: /usr/sbin/chown -R * /Applications/*'
    echo 'ALL ALL=(ALL) NOPASSWD,SETENV: /bin/rm -R -f * /Applications/*'
    echo 'ALL ALL=(ALL) NOPASSWD,SETENV: /usr/sbin/installer -pkg /opt/homebrew-shared/Caskroom/* -target /'
  } | sudo tee /etc/sudoers.d/dot-brew-cask-copy > /dev/null
  sudo chmod 440 /etc/sudoers.d/dot-brew-cask-copy
  echo "Done. Allowlist is fetched from GitHub when users run brew-allowed / brew install (no pull needed on other Macs)."
  exit 0
fi

# --- dot pull: force pull (discard local changes, match remote) ---
if [ "$1" = "--pull" ] || [ "$1" = "pull" ]; then
  echo "› Force pull (discard local changes)..."
  branch=$(git -C "$DOTFILES" branch --show-current)
  git -C "$DOTFILES" fetch origin
  git -C "$DOTFILES" reset --hard "origin/$branch"
  exit 0
fi

# --- dot --update: sync to GitHub (Brewfile + all changes, commit & push) ---
if [ "$1" = "--update" ] || [ "$1" = "update" ]; then
  echo "› Updating Brewfile..."
  brew bundle dump -f --file="$DOTFILES/Brewfile"
  echo "› Staging all changes..."
  git -C "$DOTFILES" add -A
  if ! git -C "$DOTFILES" diff --staged --quiet 2>/dev/null; then
    echo "› Committing..."
    (cd "$DOTFILES" && ./script/suggest-commit) | (cd "$DOTFILES" && git commit -F -)
  else
    echo "› Nothing to commit."
  fi
  echo "› Pulling remote changes..."
  git -C "$DOTFILES" pull --rebase
  echo "› Pushing..."
  git -C "$DOTFILES" push
  exit 0
fi

# Unknown subcommand: don't run full dot, error instead
if [ -n "$1" ]; then
  echo "Unknown command: $1" >&2
  echo "Usage: dot [update|pull|shared]" >&2
  echo "  dot shared add/remove/list — allowlist for other users" >&2
  exit 1
fi

if [ "$(uname -s)" = "Darwin" ]; then
  if [ ! -f /etc/sudoers.d/dotfiles-temp ]; then
    echo "› Setting temporary passwordless sudo"
    echo "$USER ALL=(ALL) NOPASSWD: ALL" | sudo tee /etc/sudoers.d/dotfiles-temp > /dev/null
    trap 'sudo rm /etc/sudoers.d/dotfiles-temp 2>/dev/null' EXIT
  fi

  # Ensure Xcode license is accepted
  if /usr/bin/xcrun clang 2>&1 | grep -q "license"; then
    echo "› Accepting Xcode license..."
    sudo xcodebuild -license accept
  fi
fi

# Update
git -C "$DOTFILES" pull
"$DOTFILES/homebrew/install.sh" 2>&1
brew update
brew upgrade

# Install
"$DOTFILES/script/install"
if [ "$(uname -s)" = "Darwin" ]; then
  "$DOTFILES/macos/set-defaults.sh"
  [ -f "$DOTFILES/macos/set-dock.sh" ] && chmod +x "$DOTFILES/macos/set-dock.sh" && "$DOTFILES/macos/set-dock.sh"
fi
